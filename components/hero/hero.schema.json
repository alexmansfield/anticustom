{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "hero",
  "label": "Hero",
  "version": "3.0.0",
  "category": "layout",
  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect><line x1=\"6\" y1=\"10\" x2=\"18\" y2=\"10\"></line><line x1=\"8\" y1=\"14\" x2=\"16\" y2=\"14\"></line></svg>",
  "tabs": [
    {
      "id": "content",
      "label": "Content"
    },
    {
      "id": "settings",
      "label": "Settings"
    }
  ],
  "fields": [
    {
      "name": "eyebrow",
      "type": "text",
      "label": "Eyebrow",
      "description": "Optional short label above the title",
      "default": "",
      "required": false,
      "tab": "content"
    },
    {
      "name": "title",
      "type": "text",
      "label": "Title",
      "description": "Main headline",
      "default": "Welcome to Our Site",
      "required": false,
      "tab": "content"
    },
    {
      "name": "subtitle",
      "type": "textarea",
      "label": "Subtitle",
      "description": "Supporting text below the title",
      "default": "",
      "required": false,
      "tab": "content"
    },
    {
      "name": "primary_cta_text",
      "type": "text",
      "label": "Primary Button Text",
      "description": "Label for the primary call to action (empty hides the button)",
      "default": "Get Started",
      "required": false,
      "tab": "content"
    },
    {
      "name": "primary_cta_url",
      "type": "url",
      "label": "Primary Button URL",
      "description": "Where the primary call to action links",
      "default": "#",
      "required": false,
      "tab": "content"
    },
    {
      "name": "secondary_cta_text",
      "type": "text",
      "label": "Secondary Button Text",
      "description": "Label for the secondary call to action (empty hides the button)",
      "default": "",
      "required": false,
      "tab": "content"
    },
    {
      "name": "secondary_cta_url",
      "type": "url",
      "label": "Secondary Button URL",
      "description": "Where the secondary call to action links",
      "default": "",
      "required": false,
      "tab": "content"
    },
    {
      "name": "alignment",
      "type": "select",
      "label": "Text Alignment",
      "description": "How content is aligned within the hero",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "tab": "settings"
    },
    {
      "name": "size",
      "type": "select",
      "label": "Hero Size",
      "description": "Vertical size of the hero section",
      "options": [
        {
          "value": "sm",
          "label": "Small",
          "description": "Compact hero"
        },
        {
          "value": "md",
          "label": "Medium",
          "description": "Standard size"
        },
        {
          "value": "lg",
          "label": "Large",
          "description": "Full-impact hero"
        }
      ],
      "default": "lg",
      "tab": "settings"
    },
    {
      "name": "primary_cta_variant",
      "type": "select",
      "label": "Primary Button Variant",
      "description": "Visual style of the primary call to action",
      "options": [
        {
          "value": "solid",
          "label": "Solid",
          "description": "Filled button style"
        },
        {
          "value": "outline",
          "label": "Outline",
          "description": "Subtle, bordered style"
        },
        {
          "value": "ghost",
          "label": "Ghost",
          "description": "Minimal, no border style"
        }
      ],
      "default": "solid",
      "tab": "settings"
    },
    {
      "name": "secondary_cta_variant",
      "type": "select",
      "label": "Secondary Button Variant",
      "description": "Visual style of the secondary call to action",
      "options": [
        {
          "value": "solid",
          "label": "Solid",
          "description": "Filled button style"
        },
        {
          "value": "outline",
          "label": "Outline",
          "description": "Subtle, bordered style"
        },
        {
          "value": "ghost",
          "label": "Ghost",
          "description": "Minimal, no border style"
        }
      ],
      "default": "outline",
      "tab": "settings"
    },
    {
      "name": "background_image",
      "type": "image",
      "label": "Background Image",
      "description": "Optional background image URL",
      "default": "",
      "required": false,
      "tab": "settings"
    },
    {
      "name": "palette",
      "type": "palette",
      "label": "Palette",
      "description": "Color scheme for this section",
      "default": "inherit",
      "tab": "settings"
    }
  ],
  "components_used": [
    "intro",
    "button"
  ],
  "tokens_used": [
    "space-m",
    "space-l",
    "space-xl",
    "palette-surface"
  ]
}
