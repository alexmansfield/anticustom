{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "input",
  "label": "Input",
  "version": "1.0.0",
  "category": "form",
  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"6\" width=\"18\" height=\"12\" rx=\"2\"></rect><line x1=\"7\" y1=\"12\" x2=\"7\" y2=\"12\"></line></svg>",
  "tabs": [
    {
      "id": "content",
      "label": "Content"
    },
    {
      "id": "settings",
      "label": "Settings"
    }
  ],
  "fields": [
    {
      "name": "type",
      "type": "select",
      "label": "Input Type",
      "description": "HTML input type",
      "options": [
        { "value": "text", "label": "Text" },
        { "value": "email", "label": "Email" },
        { "value": "password", "label": "Password" },
        { "value": "number", "label": "Number" },
        { "value": "tel", "label": "Telephone" },
        { "value": "url", "label": "URL" }
      ],
      "default": "text",
      "tab": "settings"
    },
    {
      "name": "label",
      "type": "text",
      "label": "Label",
      "description": "Label text shown above the input",
      "default": "Label",
      "required": true,
      "tab": "content"
    },
    {
      "name": "name",
      "type": "text",
      "label": "Name",
      "description": "Form field name attribute",
      "default": "",
      "required": true,
      "tab": "content"
    },
    {
      "name": "placeholder",
      "type": "text",
      "label": "Placeholder",
      "description": "Placeholder text when empty",
      "default": "",
      "tab": "content"
    },
    {
      "name": "value",
      "type": "text",
      "label": "Value",
      "description": "Current input value (runtime)",
      "default": "",
      "tab": "content"
    },
    {
      "name": "helper_text",
      "type": "text",
      "label": "Helper Text",
      "description": "Hint text shown below the input",
      "default": "",
      "tab": "content"
    },
    {
      "name": "error_text",
      "type": "text",
      "label": "Error Text",
      "description": "Error message shown when invalid (runtime)",
      "default": "",
      "tab": "content"
    },
    {
      "name": "required",
      "type": "boolean",
      "label": "Required",
      "description": "Whether the field is required",
      "default": false,
      "tab": "settings"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "label": "Disabled",
      "description": "Whether the field is disabled",
      "default": false,
      "tab": "settings"
    },
    {
      "name": "palette",
      "type": "palette",
      "label": "Palette",
      "description": "Color scheme for this input",
      "default": "inherit",
      "tab": "settings"
    },
    {
      "name": "class",
      "type": "text",
      "label": "Custom Class",
      "description": "Additional CSS class(es) to apply",
      "default": "",
      "tab": "settings"
    }
  ],
  "tokens_used": [
    "space-xs",
    "space-s",
    "space-m",
    "space-l",
    "text-s",
    "text-m",
    "text-l",
    "radius-m",
    "radius-l",
    "palette-surface",
    "palette-hard-contrast",
    "palette-soft-contrast"
  ]
}
