{
  "viewport": {
    "mobile": 390,
    "desktop": 1440
  },
  "typography": {
    "headings": {
      "mode": "scale",
      "default": "h6",
      "scale": {
        "mobile": { "value": 15, "ratio": 1.5 },
        "desktop": { "value": 16, "ratio": 1.618 }
      },
      "sizes": {
        "h1": { "position": 5, "spec": true },
        "h2": { "position": 4, "spec": true },
        "h3": { "position": 3, "spec": true },
        "h4": { "position": 2, "spec": true },
        "h5": { "position": 1, "spec": true },
        "h6": { "position": 0, "spec": true }
      },
      "style": {
        "leading": 8,
        "letterSpacingSlope": -0.022,
        "letterSpacingConstant": 0.35,
        "weight": 600
      },
      "customStyle": {
        "h1": { "lineHeight": 1.2, "letterSpacing": -0.02, "weight": 700 },
        "h2": { "lineHeight": 1.25, "letterSpacing": -0.02, "weight": 700 },
        "h3": { "lineHeight": 1.3, "letterSpacing": -0.01, "weight": 600 },
        "h4": { "lineHeight": 1.35, "letterSpacing": -0.01, "weight": 600 },
        "h5": { "lineHeight": 1.4, "letterSpacing": 0, "weight": 600 },
        "h6": { "lineHeight": 1.4, "letterSpacing": 0, "weight": 600 }
      }
    },
    "text": {
      "mode": "scale",
      "default": "m",
      "scale": {
        "mobile": { "value": 15, "ratio": 1.2 },
        "desktop": { "value": 16, "ratio": 1.2 }
      },
      "sizes": {
        "xl": { "position": 2 },
        "l": { "position": 1, "spec": true },
        "m": { "position": 0, "spec": true },
        "s": { "position": -1, "spec": true },
        "xs": { "position": -2 }
      }
    }
  },
  "color": {
    "colors": {
      "primary": { "value": "#336699", "position": 0, "spec": true },
      "neutral": { "value": "#737373", "position": 1, "spec": true },
      "info": { "value": "#0ea5e9", "position": 2, "spec": true },
      "success": { "value": "#22c55e", "position": 3, "spec": true },
      "warning": { "value": "#eab308", "position": 4, "spec": true },
      "danger": { "value": "#ef4444", "position": 5, "spec": true }
    },
    "stops": {
      "white": { "value": 100, "position": 7 },
      "ultra-light": { "value": 90, "position": 6, "spec": true },
      "light": { "value": 80, "position": 5, "spec": true },
      "semi-light": { "value": 65, "position": 4, "spec": true },
      "semi-dark": { "value": 35, "position": 3, "spec": true },
      "dark": { "value": 20, "position": 2, "spec": true },
      "ultra-dark": { "value": 10, "position": 1, "spec": true },
      "black": { "value": 0, "position": 0 }
    },
    "colorways": {
      "default": {
        "base": "var(--neutral-ultra-light)",
        "hard-contrast": "var(--neutral-dark)",
        "contrast": "var(--neutral)",
        "soft-contrast": "var(--neutral-light)",
        "accent": "var(--primary)"
      },
      "primary": {
        "base": "var(--primary)",
        "hard-contrast": "#ffffff",
        "contrast": "var(--primary-light)",
        "soft-contrast": "var(--primary-semi-light)",
        "accent": "var(--primary-dark)"
      }
    }
  },
  "spacing": {
    "mode": "scale",
    "default": "m",
    "scale": {
      "mobile": { "value": 12, "ratio": 1.5 },
      "desktop": { "value": 16, "ratio": 1.5 }
    },
    "sizes": {
      "xxs": { "position": -3 },
      "xs": { "position": -2, "spec": true },
      "s": { "position": -1, "spec": true },
      "m": { "position": 0, "spec": true },
      "l": { "position": 1, "spec": true },
      "xl": { "position": 2, "spec": true },
      "xxl": { "position": 3 }
    }
  },
  "borders": {
    "default": "m",
    "sizes": {
      "s": {
        "value": 1
      },
      "m": {
        "value": 2
      },
      "l": {
        "value": 4
      }
    }
  },
  "shadows": {
    "default": "none",
    "sizes": {
      "xs": {
        "x": 0,
        "y": 1,
        "blur": 1,
        "spread": 0,
        "opacity": 0.05
      },
      "s": {
        "x": 0,
        "y": 1,
        "blur": 2,
        "spread": 0,
        "opacity": 0.05
      },
      "m": {
        "x": 0,
        "y": 4,
        "blur": 6,
        "spread": -1,
        "opacity": 0.1
      },
      "l": {
        "x": 0,
        "y": 10,
        "blur": 15,
        "spread": -3,
        "opacity": 0.1
      },
      "xl": {
        "x": 0,
        "y": 20,
        "blur": 25,
        "spread": -5,
        "opacity": 0.15
      }
    }
  },
  "radius": {
    "default": "m",
    "sizes": {
      "xs": {
        "value": 2
      },
      "s": {
        "value": 4
      },
      "m": {
        "value": 8
      },
      "l": {
        "value": 16
      },
      "xl": {
        "value": 24
      },
      "full": {
        "value": 9999
      }
    }
  }
}
